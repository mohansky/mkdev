---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import Tags from "@components/blog/Tags.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const seo: AstroSeoProps = {
	title: "Tags - Explore Topics at MK Dev",
	description:
		"Browse through the diverse range of tags at MK Dev to find articles and insights tailored to your interests in web design and SEO.",
};
---

<BaseLayout seo={seo}>
	<Tags />
</BaseLayout>
