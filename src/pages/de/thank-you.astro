---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Thanks from "@components/infopages/ThankYou.astro";

const seo: AstroSeoProps = {
	title: "Thank You - MK Dev: Email Successfully Sent",
	description:
		"Thank you for reaching out to MK Dev! Your email has been successfully sent. We appreciate your interest and will respond promptly.",
};
---

<BaseLayout seo={seo}>
	<Thanks />
</BaseLayout>
