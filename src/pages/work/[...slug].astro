---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";

export async function getStaticPaths() {
	const projectsEntries = await getCollection("projects");

	return projectsEntries
		.map((entry) => {
			const [lang, ...slug] = entry.slug.split("/");
			return { params: { lang, slug: slug.join("/") || undefined }, props: entry };
		})
		.filter((entry) => entry.params.lang === "en");
}

const entry = Astro.props;
const { Content } = await entry.render();

const seo: AstroSeoProps = {
	title: `Project ${entry.data.title} - Majestico`,
	description: entry.data.description,
	canonical: `http://mohankumar.dev/work/${entry.slug}/`,
	openGraph: {
		url: entry.slug,
		title: entry.data.title,
		description: "{frontmatter.description}",
		images: [
			{
				url: "http://mohankumar.dev/opengraph/social-og.png",
				width: 1200,
				height: 630,
				alt: "Social open graph",
				type: "image/jpeg",
			},
			{
				url: "http://mohankumar.dev/opengraph/twitter-og.png",
				width: 4096,
				height: 4096,
				alt: "Twitter open graph",
				type: "image/jpeg",
			},
			{ url: "http://mohankumar.dev/opengraph/social-og.png" },
			{ url: "http://mohankumar.dev/opengraph/twitter-og.png" },
		],
		site_name: "http://mohankumar.dev/",
	},
	twitter: {
		handle: "@TwitterHandle",
		site: "@site",
		cardType: "summary_large_image",
	},
};
---

<MarkdownPostLayout frontmatter={entry.data} body={entry.body} seo={seo}>
	<Content />
</MarkdownPostLayout>
