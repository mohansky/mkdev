---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import { getLangFromUrl } from "../i18n/utils";

const { pathname } = Astro.url;

type Props = {
	seo?: AstroSeoProps;
};

const { seo: seoProp } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const shareImage = new URL("/opengraph/share.png", Astro.site).toString();
const canonical = new URL(pathname, Astro.site).toString();

const title = seoProp?.title ?? "MK Dev | Performant Web Design Solutions";
const description =
	seoProp?.description ??
	"Excels in creating fast, user-friendly websites with a focus on aesthetic design and SEO optimization, ensuring a standout online presence";

// Pages only need to pass a title and description: the canonical URL and the
// open graph data are derived from them, so they can't drift out of sync.
const seo: AstroSeoProps = {
	...seoProp,
	title,
	description,
	canonical,
	openGraph: {
		url: canonical,
		title,
		description,
		images: [
			{
				url: shareImage,
				width: 1200,
				height: 630,
				alt: "MK Dev",
				type: "image/png",
			},
		],
		site_name: "MK Dev",
		...seoProp?.openGraph,
	},
	twitter: {
		cardType: "summary_large_image",
		...seoProp?.twitter,
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "MK",
		},
	],
};

function cursorFollowerActive() {
	const paths = ["", "/", "/de/", "/de"];
	return paths.includes(pathname);
}
---

<html lang={lang}>
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
	</head>
	<body class="bg-slate-50">
		<BackgroundTexture />
		<Navigation />
		{cursorFollowerActive() && <BlobCursorFollower />}
		<slot />
		<Footer />
	</body>
</html>
