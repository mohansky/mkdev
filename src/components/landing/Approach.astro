---
import LinkBlend from "@components/global/LinkBlend.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section id="approach" class="">
	<div class="mx-auto flex h-full flex-col py-20 lg:py-32 px-20">
	
		<p class="max-w-5xl text-balance text-3xl md:text-4xl lg:text-6xl">
			Our approach starts with understanding your audience and objectives. From there, we create websites that are thoughtful, creative, and
			built to evolve alongside your ideas.
		</p>
	</div>
</section>

